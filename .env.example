# Copy this file to .env and fill in real values.
# `npm run dev` and `npm run start` both read .env automatically.

# Secret used to sign session cookies. REQUIRED in production — the app will
# refuse to start with NODE_ENV=production if this is missing, empty, or set
# to the insecure dev fallback.
#
# Generate one:   openssl rand -hex 32
SESSION_SECRET=

# Postgres connection string (Supabase or any standard Postgres).
# Supabase Dashboard → Project Settings → Database → Connection string.
#
# Pooler (transaction mode, port 6543) — recommended for serverless:
#   postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
# Direct (port 5432) — fine for a single VPS:
#   postgresql://postgres.xxxx:pass@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=