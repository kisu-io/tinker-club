# Copy this file to .env and fill in real values.
# `npm run dev` and `npm run start` both read .env automatically.

# Secret used to sign session cookies. REQUIRED in production — the app will
# refuse to start with NODE_ENV=production if this is missing, empty, or set
# to the insecure dev fallback.
#
# Generate one:   openssl rand -hex 32
SESSION_SECRET=

# Directory that holds the SQLite file (app.db). Defaults to ./data.
# In a container, set this to your mounted persistent volume (e.g. /data).
DATA_DIR=./data
