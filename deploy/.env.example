# Copy to .env (gitignored) and fill in. Used by docker-compose.yml.
# Also copy to the project root .env for local dev (npm run dev / npm run seed).

# REQUIRED. Signs session cookies. Keep this STABLE across deploys — changing it
# invalidates every session (all users get logged out). Generate once:
#   openssl rand -hex 32
SESSION_SECRET=

# Supabase Postgres connection string.
# Get this from Supabase Dashboard → Project Settings → Database → Connection string.
# Use the POOLER connection (transaction mode, port 6543) for serverless/edge deploys:
#   postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Or the direct connection (port 5432) for a single VPS:
#   postgresql://postgres.xxxx:your-password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Your domain, with an A/AAAA record pointing at this VPS. Caddy obtains and
# renews HTTPS automatically. For a local HTTP-only test, use ":80".
DOMAIN=cars.example.com

# Email for Let's Encrypt certificate notices.
ACME_EMAIL=you@example.com