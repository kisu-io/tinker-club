# Caddy reverse proxy with automatic HTTPS.
# {$DOMAIN} and {$ACME_EMAIL} come from deploy/.env (via env_file).
#
# Real deploy: DOMAIN=cars.example.com (A/AAAA record -> this VPS) — Caddy gets
#   a Let's Encrypt cert automatically on first request.
# Local test without a domain: set DOMAIN=:80 in .env (plain HTTP, no cert).

{
	# Email for Let's Encrypt notices (unused when DOMAIN is :80 / HTTP-only).
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy app:3000 {
		# Forward the real client IP so the app's rate limiter / logs are accurate,
		# and so a client can't spoof X-Forwarded-For.
		header_up X-Forwarded-For {remote_host}
	}
}
