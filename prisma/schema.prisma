// MyCollection clone — vehicle collection manager + private/club car sharing
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  language     String   @default("en")
  createdAt    DateTime @default(now())

  vehicles     Vehicle[]
  memberships  ClubMembership[]
  ownedClubs   Club[]           @relation("ClubOwner")
  bookings     Booking[]
  uploads      Document[]       @relation("DocumentUploader")
}

enum Visibility {
  PRIVATE
  CLUB
  PUBLIC
}

model Vehicle {
  id           String   @id @default(cuid())
  ownerId      String
  owner        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  year         Int
  make         String
  model        String
  imageUrl     String?
  cylinders    Int?
  performanceKw Int?
  mileageKm    Int      @default(0)
  vin          String?
  color        String?
  description  String?
  visibility   Visibility @default(PRIVATE)
  currency     String   @default("EUR")

  createdAt    DateTime @default(now())

  expenses     Expense[]
  documents    Document[]
  timeline     TimelineEvent[]
  gallery      GalleryImage[]
  shares       VehicleShare[]
  bookings     Booking[]
}

model Expense {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name      String
  category  String   // SERVICE, INSURANCE, FUEL, TAX, PURCHASE, OTHER
  type      String   @default("QUICK COST")
  amount    Float
  date      DateTime @default(now())
  notes     String?
}

model Document {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name        String
  category    String   // REGISTRATION, INSURANCE, INVOICE, MANUAL, OTHER
  type        String   @default("PDF")
  fileUrl     String?
  uploadedById String?
  uploadedBy  User?    @relation("DocumentUploader", fields: [uploadedById], references: [id])
  createdAt   DateTime @default(now())
}

model TimelineEvent {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  year        Int
  title       String
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model GalleryImage {
  id         String   @id @default(cuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  url        String
  caption    String?
  createdAt  DateTime @default(now())
}

// ---------- Car sharing (private / club) ----------

model Club {
  id          String   @id @default(cuid())
  name        String
  description String?
  ownerId     String
  owner       User     @relation("ClubOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  inviteCode  String   @unique
  createdAt   DateTime @default(now())

  memberships ClubMembership[]
  shares      VehicleShare[]
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model ClubMembership {
  id        String     @id @default(cuid())
  clubId    String
  club      Club       @relation(fields: [clubId], references: [id], onDelete: Cascade)
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      MemberRole @default(MEMBER)
  joinedAt  DateTime   @default(now())

  @@unique([clubId, userId])
}

// A vehicle shared into a club, making it bookable by members
model VehicleShare {
  id           String   @id @default(cuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  requireApproval Boolean @default(true)
  notes        String?
  createdAt    DateTime @default(now())

  @@unique([vehicleId, clubId])
}

enum BookingStatus {
  PENDING
  APPROVED
  DECLINED
  CANCELLED
  COMPLETED
}

model Booking {
  id          String        @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  borrowerId  String
  borrower    User          @relation(fields: [borrowerId], references: [id], onDelete: Cascade)

  startDate   DateTime
  endDate     DateTime
  status      BookingStatus @default(PENDING)
  purpose     String?
  createdAt   DateTime      @default(now())

  handover    HandoverLog?
}

// Handover checklist + usage log captured at pickup / return
model HandoverLog {
  id              String   @id @default(cuid())
  bookingId       String   @unique
  booking         Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  pickupMileageKm  Int?
  returnMileageKm  Int?
  pickupFuelPct    Int?
  returnFuelPct    Int?
  conditionNotes   String?
  damageReported   Boolean  @default(false)
  checklistJson    String?  // JSON array of {label, checked}
  pickedUpAt       DateTime?
  returnedAt       DateTime?
  updatedAt        DateTime @updatedAt
}
